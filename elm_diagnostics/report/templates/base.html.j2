<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %}</title>
<link rel="stylesheet" href="assets/style.css">
</head>
<body>
<nav id="sidebar">
  <h2>Contents</h2>
  <ul>
  {% for section in all_sections %}
    <li>
      <a href="{{ section.filename }}" class="{% if section.id == current_section_id %}active{% endif %}">
        {{ section.title }}
      </a>
      {% if section.subsections %}
      <ul class="subsection-links">
        {% for subsection in section.subsections %}
        <li><a href="{{ section.filename }}#{{ subsection.id }}">{{ subsection.title }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </li>
  {% endfor %}
  </ul>
  <p class="meta">Generated by elm-diagnostics</p>
</nav>

<main>
  {% block content %}{% endblock %}
</main>

<script src="assets/lightbox.js"></script>
</body>
</html>
