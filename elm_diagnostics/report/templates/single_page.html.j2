<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
{{ css }}
</style>
</head>
<body>
<nav id="sidebar">
  <h2>Contents</h2>
  <ul>
  {% for section in sections %}
    <li><a href="#{{ section.id }}">{{ section.title }}</a></li>
  {% endfor %}
  </ul>
  <p class="meta">Generated by elm-diagnostics</p>
</nav>

<main>
  <h1>{{ title }}</h1>
  <p class="meta">Case: <code>{{ casename }}</code></p>

  {% for section in sections %}
  <section id="{{ section.id }}">
    <h2>{{ section.title }}</h2>
    {% if section.description %}
    <p>{{ section.description }}</p>
    {% endif %}
    <div class="figure-grid">
      {% for fig in section.figures %}
      <div class="figure-card">
        <img src="{{ fig.path }}" alt="{{ fig.caption }}">
        <p class="caption">{{ fig.caption }}</p>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
</main>
</body>
</html>
